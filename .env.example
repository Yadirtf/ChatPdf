# Copia este archivo a .env y ajusta lo que necesites.
# Los proveedores y modelos también se cambian desde la interfaz (botón "motor"); lo guardado allí manda.

# --- Base de datos: PostgreSQL + pgvector de "docker compose up -d" (puerto 5433) ---
DATABASE_URL=postgresql://astrolabio:astrolabio@localhost:5433/astrolabio

# --- Carpeta de conocimiento: todo lo que se copie aquí se indexa solo ---
KNOWLEDGE_DIR=./conocimiento
# Revisión periódica (segundos) además de los eventos del sistema de archivos
SCAN_INTERVAL=30

# --- Embeddings: EmbeddingGemma servido por llama.cpp ---
#   llama-server -hf ggml-org/embeddinggemma-300M-GGUF --embeddings --port 8081 -np 1 -c 2048 -b 2048 -ub 2048
EMBED_BASE_URL=http://127.0.0.1:8081/v1
EMBED_MODEL=embeddinggemma-300m
EMBED_DIM=768
# Solo si usas embeddings en la nube
EMBED_API_KEY=

# --- Chat y visión: llamacpp | ollama | cloud ---
CHAT_PROVIDER=llamacpp
VISION_PROVIDER=llamacpp

#   llama-server -hf ggml-org/gemma-3-4b-it-GGUF --port 8080 -np 1 -c 8192     (multimodal: chat + visión)
LLAMACPP_BASE_URL=http://127.0.0.1:8080/v1
LLAMACPP_CHAT_MODEL=gemma-3-4b-it

OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_CHAT_MODEL=gemma4:e2b
OLLAMA_NUM_CTX=8192
OLLAMA_THINK=false

# Cualquier API compatible con OpenAI: OpenAI, Gemini, OpenRouter, Groq, Mistral...
CLOUD_BASE_URL=https://api.openai.com/v1
CLOUD_API_KEY=
CLOUD_CHAT_MODEL=gpt-4o-mini

# --- Transcripción local (faster-whisper): tiny, base, small, medium, large-v3-turbo ---
WHISPER_MODEL=small
# Vacío = detecta el idioma. "es" lo fuerza y es algo más rápido.
WHISPER_LANGUAGE=
WHISPER_DEVICE=auto

# --- Límites ---
MAX_PAGES=8
MAX_FILE_MB=200
MAX_MEDIA_MINUTES=15
MAX_IMAGES_PER_PDF=12
MAX_FRAMES_PER_VIDEO=8

# --- Recuperación ---
CHUNK_SIZE=900
CHUNK_OVERLAP=150
TOP_K=8
FULL_DOC_CHARS=9000
# Imágenes recuperadas que se le muestran al modelo de chat (0 = solo sus descripciones)
ATTACH_IMAGES=2
