# Copia este archivo a .env y ajusta lo que necesites.
# Todo lo del proveedor también se puede cambiar desde la interfaz (botón "motor").

# --- Base de datos: PostgreSQL + pgvector de "docker compose up -d" (puerto 5433) ---
# Si usas un PostgreSQL instalado en tu PC, cambia el puerto a 5432.
DATABASE_URL=postgresql://chatpdf:chatpdf@localhost:5433/chatpdf

# --- Proveedor por defecto: ollama (local, gratis) u openai (API compatible con OpenAI) ---
LLM_PROVIDER=ollama
EMBED_PROVIDER=ollama

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=gemma4:e2b
OLLAMA_EMBED_MODEL=nomic-embed-text
# Contexto que se le da al modelo (tokens). Más alto = más texto del PDF, pero más memoria.
OLLAMA_NUM_CTX=8192
# Razonamiento previo de modelos como gemma4. Más elaborado pero mucho más lento en CPU.
OLLAMA_THINK=false

# OpenAI, Groq, OpenRouter, Mistral, Together, LM Studio... (cualquier API compatible con OpenAI)
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBED_MODEL=text-embedding-3-small

# --- Límites y RAG ---
MAX_PAGES=8
MAX_FILE_MB=20
CHUNK_SIZE=900
CHUNK_OVERLAP=150
TOP_K=6
# Si el PDF tiene menos caracteres que esto, el modelo recibe el documento completo.
FULL_DOC_CHARS=9000

# --- Solo si corres la app dentro de Docker (--profile app) ---
# Por defecto usa el Ollama de tu PC. Con "--profile ollama" usa http://ollama:11434
# DOCKER_OLLAMA_URL=http://host.docker.internal:11434
