# Copia este archivo a .env y ajusta lo que necesites.
# Todo lo del proveedor también se puede cambiar desde la interfaz (botón "motor").

# --- Base de datos (fuera de Docker) ---
DATABASE_URL=postgresql://chatpdf:chatpdf@localhost:5432/chatpdf

# --- Proveedor por defecto: ollama (local, gratis) u openai (API compatible con OpenAI) ---
LLM_PROVIDER=ollama
EMBED_PROVIDER=ollama

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=gemma4:e2b
OLLAMA_EMBED_MODEL=nomic-embed-text

# OpenAI, Groq, OpenRouter, Mistral, Together, LM Studio... (cualquier API compatible con OpenAI)
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBED_MODEL=text-embedding-3-small

# --- Límites y RAG ---
MAX_PAGES=8
MAX_FILE_MB=20
CHUNK_SIZE=900
CHUNK_OVERLAP=150
TOP_K=5
